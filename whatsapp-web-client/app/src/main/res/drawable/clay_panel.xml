<?xml version="1.0" encoding="utf-8"?>
<!-- Claymorphism panel: puffy rounded surface with a soft top-lit gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/clay_highlight"
        android:endColor="@color/clay_surface" />
    <stroke
        android:width="1.5dp"
        android:color="@color/clay_divider" />
</shape>
