<?xml version="1.0" encoding="utf-8"?>
<!-- Claymorphism panel: puffy surface with a top sheen and a darker bottom rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/clay_highlight"
                android:endColor="@color/clay_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/clay_divider" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/clay_sheen"
                android:centerColor="@android:color/transparent"
                android:endColor="@color/clay_shade" />
        </shape>
    </item>
</layer-list>
