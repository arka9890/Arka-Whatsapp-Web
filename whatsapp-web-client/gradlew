#!/bin/sh
# Gradle wrapper
JAVACMD=java
APP_HOME=$(cd "$(dirname "$0")" && pwd)
GRADLE_USER_HOME=${GRADLE_USER_HOME:-$HOME/.gradle}
GRADLE_OPTS="-Dorg.gradle.daemon=false -Xmx2048m"
exec "$JAVACMD" $GRADLE_OPTS -cp "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
